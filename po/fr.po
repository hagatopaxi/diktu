#: core/src/custom.rs:86
msgid "Whisper models only transcribe whole recordings, not a live stream"
msgstr ""
"les modèles Whisper ne transcrivent que des enregistrements complets, pas un "
"flux en direct"

#: core/src/custom.rs:91
msgid "no .onnx file found: Diktu needs a sherpa-onnx (ONNX) model"
msgstr ""
"aucun fichier .onnx trouvé : Diktu a besoin d'un modèle sherpa-onnx (ONNX)"

#: core/src/custom.rs:96
msgid ""
"encoder-decoder model without a joiner (Whisper, Moonshine, SenseVoice…): "
"only streaming transducers are supported"
msgstr ""
"modèle encodeur-décodeur sans joiner (Whisper, Moonshine, SenseVoice…) : "
"seuls les transducteurs en streaming sont pris en charge"

#: core/src/custom.rs:101
msgid ""
"single-file model (CTC, Paraformer…): only streaming transducers (encoder, "
"decoder, joiner) are supported"
msgstr ""
"modèle en un seul fichier (CTC, Paraformer…) : seuls les transducteurs en "
"streaming (encoder, decoder, joiner) sont pris en charge"

