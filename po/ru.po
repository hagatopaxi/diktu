#: core/src/audio.rs:26
msgid "no microphone found"
msgstr "микрофон не найден"

#: core/src/audio.rs:39
msgid "unsupported audio format: {format}"
msgstr "неподдерживаемый аудиоформат: {format}"

#: core/src/custom.rs:86
msgid "Whisper models only transcribe whole recordings, not a live stream"
msgstr ""
"модели Whisper распознают только целые записи, а не поток в реальном времени"

#: core/src/custom.rs:91
msgid "no .onnx file found: Diktu needs a sherpa-onnx (ONNX) model"
msgstr "файл .onnx не найден: Diktu нужна модель sherpa-onnx (ONNX)"

#: core/src/custom.rs:96
msgid ""
"encoder-decoder model without a joiner (Whisper, Moonshine, SenseVoice…): "
"only streaming transducers are supported"
msgstr ""
"модель кодировщик-декодировщик без joiner (Whisper, Moonshine, SenseVoice…): "
"поддерживаются только потоковые трансдьюсеры"

#: core/src/custom.rs:101
msgid ""
"single-file model (CTC, Paraformer…): only streaming transducers (encoder, "
"decoder, joiner) are supported"
msgstr ""
"однофайловая модель (CTC, Paraformer…): поддерживаются только потоковые "
"трансдьюсеры (encoder, decoder, joiner)"

#: core/src/custom.rs:119
msgid "missing `{role}` file"
msgstr "отсутствует файл `{role}`"

#: core/src/custom.rs:139
msgid "the model needs a name"
msgstr "у модели должно быть имя"

#: core/src/custom.rs:143
msgid "`{lang}` is not a language code (ISO 639-1, e.g. fr)"
msgstr "`{lang}` — не код языка (ISO 639-1, например ru)"

#: core/src/custom.rs:150
msgid "a model named “{name}” is already imported"
msgstr "модель «{name}» уже импортирована"

#: core/src/custom.rs:209
msgid "copying {name}: {error}"
msgstr "копирование {name}: {error}"

#: core/src/custom.rs:267
msgid "“{input}” is not a Hugging Face repository (owner/name)"
msgstr "«{input}» — не репозиторий Hugging Face (владелец/имя)"

#: core/src/custom.rs:290 core/src/download.rs:33
msgid "network error: {error}"
msgstr "ошибка сети: {error}"

#: core/src/custom.rs:295
msgid "{repo}: private or gated repository"
msgstr "{repo}: закрытый репозиторий или репозиторий с ограниченным доступом"

#: core/src/custom.rs:299
msgid "{repo}: no such repository"
msgstr "{repo}: репозиторий не существует"

#: core/src/custom.rs:304
msgid "{repo}: unexpected answer: {error}"
msgstr "{repo}: неожиданный ответ: {error}"

#: core/src/custom.rs:312
msgid "{name}: unsafe path"
msgstr "{name}: небезопасный путь"

#: core/src/custom.rs:330
msgid "see huggingface.co/{repo}"
msgstr "см. huggingface.co/{repo}"

#: core/src/custom.rs:366
msgid "{file}: changed since import"
msgstr "{file}: изменён после импорта"

#: core/src/custom.rs:370
msgid "{file}: not an ONNX file"
msgstr "{file}: не файл ONNX"

#: core/src/custom.rs:377
msgid "missing tokens file"
msgstr "отсутствует файл tokens"

#: core/src/custom.rs:383
msgid "{count} tokens"
msgstr "токенов: {count}"

#: core/src/custom.rs:389
msgid "transcribes silence as “{text}”: files likely mismatched"
msgstr ""
"распознаёт тишину как «{text}»: вероятно, файлы не подходят друг к другу"

#: core/src/custom.rs:405
msgid "too slow for live dictation (real-time factor {rtf})"
msgstr ""
"слишком медленно для диктовки в реальном времени (коэффициент реального "
"времени {rtf})"

#: core/src/custom.rs:410
msgid "real-time factor {rtf}"
msgstr "коэффициент реального времени {rtf}"

#: core/src/custom.rs:419
msgid ""
"poor transcription of the {lang} test sentence ({percent} % word errors): "
"“{text}”. Wrong language or broken model?"
msgstr ""
"плохое распознавание тестовой фразы {lang} ({percent} % ошибок в словах): "
"«{text}». Не тот язык или повреждённая модель?"

#: core/src/custom.rs:428
msgid "{percent} % word errors on the {lang} test sentence"
msgstr "{percent} % ошибок в словах на тестовой фразе {lang}"

#: core/src/custom.rs:433
msgid "accuracy not checked: no {lang} test sentence"
msgstr "точность не проверена: нет тестовой фразы {lang}"

#: core/src/custom.rs:461
msgid "tokens line {line}: expected “symbol id”"
msgstr "tokens, строка {line}: ожидается «символ id»"

#: core/src/custom.rs:469
msgid "tokens: ids must run from 0 without gaps"
msgstr "tokens: идентификаторы должны идти с 0 без пропусков"

#: core/src/custom.rs:479
msgid "not a WAV file"
msgstr "не файл WAV"

#: core/src/custom.rs:503
msgid "WAV must be 16 kHz mono 16-bit PCM"
msgstr "WAV должен быть 16 кГц, моно, 16-битный PCM"

#: core/src/download.rs:32
msgid "download cancelled"
msgstr "загрузка отменена"

#: core/src/download.rs:34
msgid "disk error: {error}"
msgstr "ошибка диска: {error}"

#: core/src/download.rs:35
msgid "{file}: SHA-256 mismatch"
msgstr "{file}: несовпадение SHA-256"

#: core/src/pipeline.rs:75
msgid "no model installed"
msgstr "модель не установлена"

#: core/src/stt.rs:35
msgid "no `{prefix}*` file in model"
msgstr "в модели нет файла `{prefix}*`"

#: core/src/stt.rs:47
msgid "sherpa-onnx could not load the model in {dir}"
msgstr "sherpa-onnx не смог загрузить модель из {dir}"

#: app/src/main.rs:195
msgid "could not start the model check: {error}"
msgstr "не удалось запустить проверку модели: {error}"

#: app/src/main.rs:231
msgid "no message"
msgstr "нет сообщения"

#: app/src/main.rs:228
msgid "the speech engine crashed loading this model ({message})"
msgstr ""
"движок распознавания аварийно завершился при загрузке этой модели ({message})"

#: app/src/main.rs:244
msgid "Listen for the dictation shortcut with no window open"
msgstr "Ожидать сочетание клавиш диктовки без открытых окон"

#: app/src/main.rs:252
msgid "not allowed"
msgstr "не разрешено"

#: app/src/main.rs:427
msgid "keyboard access denied: {error}"
msgstr "доступ к клавиатуре запрещён: {error}"

#: app/src/main.rs:450
msgid ""
"global shortcut unavailable ({error}): bind a GNOME shortcut to “diktu --"
"toggle”"
msgstr ""
"глобальное сочетание клавиш недоступно ({error}): назначьте в GNOME "
"сочетание для «diktu --toggle»"

#: app/src/onboarding.rs:129 app/src/preferences.rs:64
#: app/src/preferences.rs:674
msgid "Language"
msgstr "Язык"

#: app/src/onboarding.rs:136
msgid "Model"
msgstr "Модель"

#: app/src/onboarding.rs:146
msgid "{size} MB · license {license}"
msgstr "{size} МБ · лицензия {license}"

#: app/src/onboarding.rs:184 app/src/onboarding.rs:378
msgid "Continue"
msgstr "Продолжить"

#: app/src/onboarding.rs:188
msgid "Welcome to {app}"
msgstr "Добро пожаловать в {app}"

#: app/src/onboarding.rs:190
msgid ""
"Dictate text anywhere, recognized on your computer. Which language will you "
"speak? Its model downloads while you set up the rest."
msgstr ""
"Диктуйте текст где угодно, распознавание происходит на вашем компьютере. На "
"каком языке вы будете говорить? Его модель загружается, пока вы настраиваете "
"остальное."

#: app/src/onboarding.rs:235
msgid "Downloading {model}…"
msgstr "Загрузка {model}…"

#: app/src/onboarding.rs:263
msgid "Downloading {model}… {done} / {total} MB"
msgstr "Загрузка {model}… {done} / {total} МБ"

#: app/src/onboarding.rs:274
msgid "{model} is ready"
msgstr "{model} готова"

#: app/src/onboarding.rs:279
msgid "Download failed: {error}. Retry from the preferences."
msgstr "Не удалось загрузить: {error}. Повторите в настройках."

#: app/src/onboarding.rs:303
msgid "Microphone"
msgstr "Микрофон"

#: app/src/onboarding.rs:304
msgid "Open only while you dictate. No audio leaves your computer."
msgstr "Открыт только во время диктовки. Звук не покидает ваш компьютер."

#: app/src/onboarding.rs:308
msgid "Run in the background"
msgstr "Работа в фоне"

#: app/src/onboarding.rs:309
msgid "Listen for the shortcut with no window open."
msgstr "Ждать сочетание клавиш без открытого окна."

#: app/src/onboarding.rs:313
msgid "Type at the cursor"
msgstr "Печатать у курсора"

#: app/src/onboarding.rs:315
msgid ""
"Type the recognized text in the focused app. GNOME shows a remote control "
"icon while {app} types."
msgstr ""
"Печатать распознанный текст в активном приложении. GNOME показывает значок "
"удалённого управления, пока {app} печатает."

#: app/src/onboarding.rs:319
msgid "Allow…"
msgstr "Разрешить…"

#: app/src/onboarding.rs:320 app/src/onboarding.rs:402
msgid "Skip"
msgstr "Пропустить"

#: app/src/onboarding.rs:324 app/src/preferences.rs:260
msgid "Permissions"
msgstr "Разрешения"

#: app/src/onboarding.rs:325
msgid "GNOME asks you to confirm each one, one dialog after the other."
msgstr "GNOME попросит подтвердить каждое разрешение, одно окно за другим."

#: app/src/onboarding.rs:342
msgid "Not granted ({error}). It will be asked again later."
msgstr "Не предоставлено ({error}). Разрешение будет запрошено снова позже."

#: app/src/onboarding.rs:397 app/src/preferences.rs:120 app/src/shortcut.rs:20
msgid "Start or stop dictation"
msgstr "Начать или остановить диктовку"

#: app/src/onboarding.rs:398
msgid "Not chosen yet"
msgstr "Ещё не выбрано"

#: app/src/onboarding.rs:401
msgid "Choose the Shortcut…"
msgstr "Выбрать сочетание клавиш…"

#: app/src/onboarding.rs:406
msgid "Keyboard Shortcut"
msgstr "Сочетание клавиш"

#: app/src/onboarding.rs:408
msgid ""
"Press it anywhere to start dictating, and again to stop. {app} suggests "
"{key}; GNOME lets you confirm it or pick another one.\n"
"\n"
"On a laptop, {key} often controls the volume or brightness: press Fn+{key}, "
"or turn on Fn Lock (often Fn+Esc)."
msgstr ""
"Нажмите его где угодно, чтобы начать диктовку, и снова, чтобы остановить. "
"{app} предлагает {key}; GNOME позволит подтвердить его или выбрать другую "
"клавишу.\n"
"\n"
"На ноутбуке {key} часто управляет громкостью или яркостью: нажмите Fn+{key} "
"или включите блокировку Fn (часто Fn+Esc)."

#: app/src/onboarding.rs:445
msgid "Start Using {app}"
msgstr "Начать работу с {app}"

#: app/src/onboarding.rs:449
msgid "All Set"
msgstr "Всё готово"

#: app/src/onboarding.rs:459
msgid "Press {key} anywhere"
msgstr "Нажмите {key} где угодно"

#: app/src/onboarding.rs:461
msgid "Choose “Start dictation” in the {app} menu of the top bar"
msgstr "Выберите «Начать диктовку» в меню {app} верхней панели"

#: app/src/onboarding.rs:470
msgid "Dictation works once the model is downloaded."
msgstr "Диктовка заработает, когда модель будет загружена."

#: app/src/onboarding.rs:481
msgid "{start}, speak, then pause: the text is typed at the cursor."
msgstr ""
"{start}, говорите, затем сделайте паузу: текст будет напечатан у курсора."

#: app/src/onboarding.rs:485
msgid "The {app} menu in the top bar also opens the preferences."
msgstr "Меню {app} верхней панели также открывает настройки."

#: app/src/preferences.rs:47
msgid "{app} Preferences"
msgstr "Параметры {app}"

#: app/src/preferences.rs:72
msgid "Dictation"
msgstr "Диктовка"

#: app/src/preferences.rs:79
msgid "Models"
msgstr "Модели"

#: app/src/preferences.rs:81
msgid ""
"Download a model for the chosen language to start dictating. Models come "
"from Hugging Face, are verified (SHA-256), then used offline."
msgstr ""
"Загрузите модель для выбранного языка, чтобы начать диктовку. Модели берутся "
"с Hugging Face, проверяются (SHA-256) и затем работают без сети."

#: app/src/preferences.rs:114
msgid "Shortcut"
msgstr "Сочетание клавиш"

#: app/src/preferences.rs:116
msgid ""
"GNOME assigns the shortcut. Fallback: a custom GNOME shortcut that runs "
"“diktu --toggle”."
msgstr ""
"Сочетание назначает GNOME. Запасной вариант: своё сочетание клавиш GNOME, "
"запускающее «diktu --toggle»."

#: app/src/preferences.rs:125
msgid "GlobalShortcuts portal unavailable"
msgstr "Портал GlobalShortcuts недоступен"

#: app/src/preferences.rs:129
msgid "Change…"
msgstr "Изменить…"

#: app/src/preferences.rs:138
msgid "Change it in Settings → Apps → Diktu"
msgstr "Измените его в Параметры → Приложения → Diktu"

#: app/src/preferences.rs:147
msgid "Behavior"
msgstr "Поведение"

#: app/src/preferences.rs:150
msgid "End-of-speech silence (s)"
msgstr "Пауза в конце речи (с)"

#: app/src/preferences.rs:151
msgid "Silence after speech that stops listening"
msgstr "Тишина после речи, которая останавливает прослушивание"

#: app/src/preferences.rs:156
msgid "Capitalize and end with a period"
msgstr "Заглавная буква и точка в конце"

#: app/src/preferences.rs:161
msgid "Delay between keys (ms)"
msgstr "Задержка между клавишами (мс)"

#: app/src/preferences.rs:162
msgid "Increase it if some apps drop characters"
msgstr "Увеличьте, если некоторые приложения теряют символы"

#: app/src/preferences.rs:166
msgid "Start and stop sounds"
msgstr "Звуки начала и конца"

#: app/src/preferences.rs:176
msgid "Volume"
msgstr "Громкость"

#: app/src/preferences.rs:187
msgid "About {app}"
msgstr "О программе {app}"

#: app/src/preferences.rs:188
msgid "Version, permissions, licenses, source code"
msgstr "Версия, разрешения, лицензии, исходный код"

#: app/src/preferences.rs:205
msgid "Same as the system"
msgstr "Как в системе"

#: app/src/preferences.rs:213
msgid "Interface language"
msgstr "Язык интерфейса"

#: app/src/preferences.rs:239
msgid "Interface"
msgstr "Интерфейс"

#: app/src/preferences.rs:262
msgid ""
"• Microphone: open only while you dictate; no audio leaves your machine."
msgstr ""
"• Микрофон: открыт только во время диктовки; звук не покидает ваш компьютер."

#: app/src/preferences.rs:263
msgid "• Remote desktop (keyboard): types the recognized text at the cursor."
msgstr ""
"• Удалённый рабочий стол (клавиатура): печатает распознанный текст в позиции "
"курсора."

#: app/src/preferences.rs:264
msgid "• Global shortcut: starts and stops dictation from any app."
msgstr ""
"• Глобальное сочетание клавиш: запускает и останавливает диктовку из любого "
"приложения."

#: app/src/preferences.rs:265
msgid "• Run in background: listens for the shortcut with no window open."
msgstr "• Работа в фоне: ожидает сочетание клавиш без открытых окон."

#: app/src/preferences.rs:266
msgid "• Network: only to download models from Hugging Face, when you ask."
msgstr "• Сеть: только для загрузки моделей с Hugging Face по вашему запросу."

#: app/src/preferences.rs:267
msgid "• Status icon: the tray icon showing whether dictation is on."
msgstr "• Значок состояния: значок в трее показывает, идёт ли диктовка."

