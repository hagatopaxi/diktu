{
  "id": "fr.gwenael_leger.Diktu",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "diktu",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--share=network",
    "--share=ipc",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [
    {
      "name": "onnxruntime",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/include /app/lib",
        "cp -r include /app/include/onnxruntime",
        "cp -a lib/libonnxruntime.so lib/libonnxruntime.so.* /app/lib/"
      ],
      "cleanup": ["/include"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/microsoft/onnxruntime/releases/download/v1.28.2/onnxruntime-linux-x64-1.28.2.tgz",
          "sha256": "d7209b8751b27b862b0c76332c2e20e203396edb5dab700ecf4bb485cf147415",
          "only-arches": ["x86_64"],
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/microsoft/onnxruntime/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": "\"https://github.com/microsoft/onnxruntime/releases/download/v\" + $version + \"/onnxruntime-linux-x64-\" + $version + \".tgz\""
          }
        },
        {
          "type": "archive",
          "url": "https://github.com/microsoft/onnxruntime/releases/download/v1.28.2/onnxruntime-linux-aarch64-1.28.2.tgz",
          "sha256": "f020b3d31106cc7db03889b4a5c21e7c38ce4a09ad26119c11d1ad6d3fa0ec04",
          "only-arches": ["aarch64"],
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/microsoft/onnxruntime/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": "\"https://github.com/microsoft/onnxruntime/releases/download/v\" + $version + \"/onnxruntime-linux-aarch64-\" + $version + \".tgz\""
          }
        }
      ]
    },
    {
      "name": "sherpa-onnx",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DSHERPA_ONNX_ENABLE_C_API=ON",
        "-DSHERPA_ONNX_ENABLE_BINARY=OFF",
        "-DSHERPA_ONNX_BUILD_C_API_EXAMPLES=OFF",
        "-DSHERPA_ONNX_ENABLE_PYTHON=OFF",
        "-DSHERPA_ONNX_ENABLE_TESTS=OFF",
        "-DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF",
        "-DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF",
        "-DSHERPA_ONNX_ENABLE_TTS=OFF",
        "-DSHERPA_ONNX_ENABLE_SPEAKER_DIARIZATION=OFF"
      ],
      "build-options": {
        "env": {
          "SHERPA_ONNXRUNTIME_INCLUDE_DIR": "/app/include/onnxruntime",
          "SHERPA_ONNXRUNTIME_LIB_DIR": "/app/lib"
        }
      },
      "cleanup": ["/include", "/lib/libsherpa-onnx-cxx-api.so", "/sherpa-onnx.pc"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/k2-fsa/sherpa-onnx.git",
          "tag": "v1.13.8",
          "commit": "11afbd009a7f8c08f4bcf2fc1b265d0df4670fbf",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v([\\d.]+)$"
          }
        },
        {
          "type": "file",
          "url": "https://github.com/csukuangfj/kaldi-native-fbank/archive/refs/tags/v1.22.3.tar.gz",
          "sha256": "9176cc66fc7ce1edf85cf355b06e320c57db6297df74277f575183468893cf61",
          "dest-filename": "kaldi-native-fbank-1.22.3.tar.gz"
        },
        {
          "type": "file",
          "url": "https://github.com/mborgerding/kissfft/archive/febd4caeed32e33ad8b2e0bb5ea77542c40f18ec.zip",
          "sha256": "497103e664168ebe39580b757adbe616f6cf85a16572af581ca7bc42d0ab13fd",
          "dest-filename": "kissfft-febd4caeed32e33ad8b2e0bb5ea77542c40f18ec.zip"
        },
        {
          "type": "file",
          "url": "https://github.com/k2-fsa/kaldi-decoder/archive/refs/tags/v0.3.0.tar.gz",
          "sha256": "b9f34cfb4fd3b1344100eead79ef4d37aa15962274b9e3056de345021f76a1b0",
          "dest-filename": "kaldi-decoder-0.3.0.tar.gz"
        },
        {
          "type": "file",
          "url": "https://github.com/k2-fsa/kaldifst/archive/refs/tags/v1.8.0.tar.gz",
          "sha256": "3f247b7e5a2409071202f5e2bc6200060f66728c0a3443c03923ad2723e040b3",
          "dest-filename": "kaldifst-1.8.0.tar.gz"
        },
        {
          "type": "file",
          "url": "https://github.com/csukuangfj/openfst/archive/refs/tags/v1.8.5-2026-07-09.tar.gz",
          "sha256": "2ff712a32952fcb01d351121a6bc8ccf4fdc6b2aa06ce8df2b3095dedd518c0e",
          "dest-filename": "openfst-1.8.5-2026-07-09.tar.gz"
        },
        {
          "type": "file",
          "url": "https://gitlab.com/libeigen/eigen/-/archive/5.0.1/eigen-5.0.1.tar.gz",
          "sha256": "e9c326dc8c05cd1e044c71f30f1b2e34a6161a3b6ecf445d56b53ff1669e3dec",
          "dest-filename": "eigen-5.0.1.tar.gz"
        },
        {
          "type": "file",
          "url": "https://github.com/pkufool/simple-sentencepiece/archive/refs/tags/v0.7.tar.gz",
          "sha256": "1748a822060a35baa9f6609f84efc8eb54dc0e74b9ece3d82367b7119fdc75af",
          "dest-filename": "simple-sentencepiece-0.7.tar.gz"
        },
        {
          "type": "file",
          "url": "https://github.com/nlohmann/json/archive/refs/tags/v3.12.0.tar.gz",
          "sha256": "4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187",
          "dest-filename": "json-3.12.0.tar.gz"
        }
      ]
    },
    {
      "name": "diktu",
      "buildsystem": "meson",
      "config-opts": ["--buildtype=release", "-Doffline=true", "-Dshared_sherpa_onnx=true"],
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/diktu/cargo",
          "CARGO_NET_OFFLINE": "true",
          "SHERPA_ONNX_LIB_DIR": "/app/lib"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": ["target", "_build", ".flatpak-builder", "build-dir", "repo", ".git"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
