<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>fr.gwenael_leger.Diktu</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name translate="no">Diktu</name>
  <summary>Dictate text at the cursor with local speech recognition</summary>
  <developer id="fr.gwenael_leger">
    <name translate="no">Gwenaël Léger</name>
  </developer>
  <description>
    <p>
      Diktu runs in the background. Press a global shortcut, speak, and the text is typed
      at the cursor of the focused application as you talk. Listening stops by itself when you
      stop speaking.
    </p>
    <p>
      Speech recognition runs entirely on your computer with a streaming model downloaded once
      from Hugging Face. No audio leaves your machine. No telemetry is collected: Diktu does nothing but speech-to-text.
    </p>
  </description>
  <url type="homepage">https://github.com/hagatopaxi/diktu</url>
  <url type="bugtracker">https://github.com/hagatopaxi/diktu/issues</url>
  <url type="vcs-browser">https://github.com/hagatopaxi/diktu</url>
  <launchable type="desktop-id">fr.gwenael_leger.Diktu.desktop</launchable>
  <provides>
    <binary>diktu</binary>
  </provides>
  <categories>
    <category>Utility</category>
    <category>Accessibility</category>
  </categories>
  <requires>
    <internet>first-run</internet>
  </requires>
  <recommends>
    <control>keyboard</control>
  </recommends>
  <supports>
    <control>voice</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.2.0" date="2026-10-03">
      <description>
        <p>Add your own speech models from Hugging Face or a local folder, in the language of your choice: Diktu checks that each one works before using it.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-03">
      <description>
        <p>First release: French streaming dictation, global shortcut, model manager.</p>
      </description>
    </release>
  </releases>
</component>
