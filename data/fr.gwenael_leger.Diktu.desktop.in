[Desktop Entry]
Type=Application
Name=@NAME@
GenericName=Voice Dictation
Comment=Dictate text at the cursor with local speech recognition
Exec=@BINDIR@/@BIN@
Icon=@APP_ID@
Terminal=false
Categories=Utility;Accessibility;
Keywords=speech;dictation;voice;recognition;
StartupNotify=false
X-GNOME-UsesNotifications=true
