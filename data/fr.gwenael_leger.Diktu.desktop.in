[Desktop Entry]
Type=Application
Name=Diktu
GenericName=Voice Dictation
GenericName[fr]=Dictée vocale
Comment=Dictate text at the cursor with local speech recognition
Comment[fr]=Dicter du texte au curseur, reconnaissance vocale locale
